{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "My IELTS",
  "version": "0.1.0",
  "identifier": "com.myielts.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3333",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "My IELTS",
        "width": 1180,
        "height": 760,
        "minWidth": 375,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
